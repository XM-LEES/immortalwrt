From: OpenWrt Contributor <openwrt@example.com>
Date: Thu, 5 Mar 2026 00:00:00 +0000
Subject: [PATCH] cpufreq: add MT7621 clock scaling driver

Add a simple cpufreq driver for MT7621 by programming the CPU PLL
feedback divider via syscon regmap.

It exposes a conservative set of frequencies:
- 880 MHz (default stock)
- 1000 MHz
- 1100 MHz

Signed-off-by: OpenWrt Contributor <openwrt@example.com>
---
 drivers/cpufreq/Kconfig          |  12 ++
 drivers/cpufreq/Makefile         |   1 +
 drivers/cpufreq/mt7621-cpufreq.c | 228 ++++++++++++++++++++++++++++++
 3 files changed, 241 insertions(+)
 create mode 100644 drivers/cpufreq/mt7621-cpufreq.c

diff --git a/drivers/cpufreq/Kconfig b/drivers/cpufreq/Kconfig
index f089a1b9c0..33a128f8f5 100644
--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -248,6 +248,19 @@ config BMIPS_CPUFREQ
 
 	  If in doubt, say N.
 
+config MT7621_CPUFREQ
+	tristate "MT7621 CPUFreq driver"
+	depends on RALINK && SOC_MT7621
+	depends on MFD_SYSCON
+	help
+	  This option adds a CPUFreq driver for MediaTek MT7621 SoCs.
+
+	  The driver updates CPU PLL settings through the MT7621 syscon
+	  registers and supports a small set of frequencies intended for
+	  stock and overclock profiles.
+
+	  If in doubt, say N.
+
 config LOONGSON2_CPUFREQ
 	tristate "Loongson2 CPUFreq Driver"
 	depends on LEMOTE_MACH2F
diff --git a/drivers/cpufreq/Makefile b/drivers/cpufreq/Makefile
index 0f184031dd..b7301f0f92 100644
--- a/drivers/cpufreq/Makefile
+++ b/drivers/cpufreq/Makefile
@@ -102,6 +102,7 @@ obj-$(CONFIG_POWERNV_CPUFREQ)		+= powernv-cpufreq.o
 ##################################################################################
 # Other platform drivers
 obj-$(CONFIG_BMIPS_CPUFREQ)		+= bmips-cpufreq.o
+obj-$(CONFIG_MT7621_CPUFREQ)		+= mt7621-cpufreq.o
 obj-$(CONFIG_LOONGSON2_CPUFREQ)		+= loongson2_cpufreq.o
 obj-$(CONFIG_LOONGSON3_CPUFREQ)		+= loongson3_cpufreq.o
 obj-$(CONFIG_SH_CPU_FREQ)		+= sh-cpufreq.o
diff --git a/drivers/cpufreq/mt7621-cpufreq.c b/drivers/cpufreq/mt7621-cpufreq.c
new file mode 100644
index 0000000000..37e9d1052e
--- /dev/null
+++ b/drivers/cpufreq/mt7621-cpufreq.c
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CPU frequency scaling for MediaTek MT7621 SoCs
+ */
+
+#include <linux/bitfield.h>
+#include <linux/cpufreq.h>
+#include <linux/math64.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+
+/* Configuration registers */
+#define SYSC_REG_SYSTEM_CONFIG0		0x10
+#define SYSC_REG_CLKCFG0		0x2c
+#define SYSC_REG_CUR_CLK_STS		0x44
+#define MEMC_REG_CPU_PLL		0x648
+
+#define XTAL_MODE_SEL_MASK		GENMASK(8, 6)
+#define CPU_CLK_SEL_MASK		GENMASK(31, 30)
+#define CUR_CPU_FDIV_MASK		GENMASK(12, 8)
+#define CUR_CPU_FFRAC_MASK		GENMASK(4, 0)
+#define CPU_PLL_PREDIV_MASK		GENMASK(13, 12)
+#define CPU_PLL_FBDIV_MASK		GENMASK(10, 4)
+
+#define MT7621_CPUFREQ_NAME		"mt7621-cpufreq"
+#define MT7621_TRANSITION_LATENCY_NS	200000
+
+static const u8 mt7621_prediv_tbl[] = { 0, 1, 2, 2 };
+
+static const unsigned int mt7621_target_freqs_khz[] = {
+	880000,
+	1000000,
+	1100000,
+};
+
+struct mt7621_cpufreq {
+	struct regmap *sysc;
+	struct regmap *memc;
+	u32 prediv;
+	u32 ffiv;
+	u32 ffrac;
+	u32 xtal_hz;
+};
+
+static struct mt7621_cpufreq mt7621_priv;
+static struct cpufreq_frequency_table
+mt7621_freq_table[ARRAY_SIZE(mt7621_target_freqs_khz) + 1];
+
+static unsigned long mt7621_get_xtal_hz(struct mt7621_cpufreq *priv)
+{
+	u32 val;
+
+	regmap_read(priv->sysc, SYSC_REG_SYSTEM_CONFIG0, &val);
+	val = FIELD_GET(XTAL_MODE_SEL_MASK, val);
+
+	if (val <= 2)
+		return 20000000;
+	if (val <= 5)
+		return 40000000;
+
+	return 25000000;
+}
+
+static int mt7621_update_factors(struct mt7621_cpufreq *priv)
+{
+	u32 curclk, pll;
+
+	regmap_read(priv->sysc, SYSC_REG_CUR_CLK_STS, &curclk);
+	regmap_read(priv->memc, MEMC_REG_CPU_PLL, &pll);
+
+	priv->ffiv = FIELD_GET(CUR_CPU_FDIV_MASK, curclk);
+	priv->ffrac = FIELD_GET(CUR_CPU_FFRAC_MASK, curclk);
+	if (!priv->ffiv || !priv->ffrac)
+		return -EINVAL;
+
+	priv->prediv = FIELD_GET(CPU_PLL_PREDIV_MASK, pll);
+	if (priv->prediv >= ARRAY_SIZE(mt7621_prediv_tbl))
+		return -EINVAL;
+
+	priv->xtal_hz = mt7621_get_xtal_hz(priv);
+	return 0;
+}
+
+static unsigned int mt7621_fbdiv_to_khz(struct mt7621_cpufreq *priv, u32 fbdiv)
+{
+	u64 pll_hz;
+
+	pll_hz = (u64)(fbdiv + 1) * priv->xtal_hz;
+	pll_hz >>= mt7621_prediv_tbl[priv->prediv];
+	pll_hz = div_u64(pll_hz * priv->ffrac, priv->ffiv);
+
+	return div_u64(pll_hz, 1000);
+}
+
+static int mt7621_khz_to_fbdiv(struct mt7621_cpufreq *priv, unsigned int khz,
+			       u32 *fbdiv)
+{
+	u64 pll_hz, fbdiv_plus_one;
+
+	pll_hz = (u64)khz * 1000;
+	pll_hz = div_u64(pll_hz * priv->ffiv, priv->ffrac);
+	pll_hz <<= mt7621_prediv_tbl[priv->prediv];
+
+	fbdiv_plus_one = DIV_ROUND_CLOSEST_ULL(pll_hz, priv->xtal_hz);
+	if (!fbdiv_plus_one)
+		return -EINVAL;
+
+	fbdiv_plus_one -= 1;
+	if (fbdiv_plus_one > FIELD_MAX(CPU_PLL_FBDIV_MASK))
+		return -EINVAL;
+
+	*fbdiv = fbdiv_plus_one;
+	return 0;
+}
+
+static unsigned int mt7621_cpufreq_get(unsigned int cpu)
+{
+	struct mt7621_cpufreq *priv = &mt7621_priv;
+	u32 clkcfg, clk_sel, pll;
+
+	if (mt7621_update_factors(priv))
+		return 0;
+
+	regmap_read(priv->sysc, SYSC_REG_CLKCFG0, &clkcfg);
+	clk_sel = FIELD_GET(CPU_CLK_SEL_MASK, clkcfg);
+
+	switch (clk_sel) {
+	case 0:
+		return 500000;
+	case 1:
+		regmap_read(priv->memc, MEMC_REG_CPU_PLL, &pll);
+		return mt7621_fbdiv_to_khz(priv,
+				FIELD_GET(CPU_PLL_FBDIV_MASK, pll));
+	default:
+		return div_u64((u64)priv->xtal_hz * priv->ffrac,
+			       (u64)priv->ffiv * 1000);
+	}
+}
+
+static int mt7621_cpufreq_target_index(struct cpufreq_policy *policy,
+				       unsigned int index)
+{
+	struct mt7621_cpufreq *priv = &mt7621_priv;
+	unsigned int target_khz = policy->freq_table[index].frequency;
+	u32 fbdiv;
+	int ret;
+
+	ret = mt7621_update_factors(priv);
+	if (ret)
+		return ret;
+
+	ret = mt7621_khz_to_fbdiv(priv, target_khz, &fbdiv);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->memc, MEMC_REG_CPU_PLL,
+				 CPU_PLL_FBDIV_MASK,
+				 FIELD_PREP(CPU_PLL_FBDIV_MASK, fbdiv));
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(priv->sysc, SYSC_REG_CLKCFG0,
+				  CPU_CLK_SEL_MASK,
+				  FIELD_PREP(CPU_CLK_SEL_MASK, 1));
+}
+
+static int mt7621_cpufreq_init(struct cpufreq_policy *policy)
+{
+	struct mt7621_cpufreq *priv = &mt7621_priv;
+	int ret, i, n = 0;
+
+	ret = mt7621_update_factors(priv);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(mt7621_target_freqs_khz); i++) {
+		u32 fbdiv;
+
+		ret = mt7621_khz_to_fbdiv(priv, mt7621_target_freqs_khz[i],
+					  &fbdiv);
+		if (ret)
+			continue;
+
+		mt7621_freq_table[n].frequency = mt7621_target_freqs_khz[i];
+		n++;
+	}
+
+	if (!n)
+		return -EINVAL;
+
+	mt7621_freq_table[n].frequency = CPUFREQ_TABLE_END;
+
+	cpumask_copy(policy->cpus, cpu_possible_mask);
+	policy->shared_type = CPUFREQ_SHARED_TYPE_ANY;
+
+	cpufreq_generic_init(policy, mt7621_freq_table,
+			    MT7621_TRANSITION_LATENCY_NS);
+
+	return 0;
+}
+
+static struct cpufreq_driver mt7621_cpufreq_driver = {
+	.flags		= CPUFREQ_NEED_INITIAL_FREQ_CHECK,
+	.verify		= cpufreq_generic_frequency_table_verify,
+	.target_index	= mt7621_cpufreq_target_index,
+	.get		= mt7621_cpufreq_get,
+	.init		= mt7621_cpufreq_init,
+	.attr		= cpufreq_generic_attr,
+	.name		= MT7621_CPUFREQ_NAME,
+};
+
+static int __init mt7621_cpufreq_driver_init(void)
+{
+	struct mt7621_cpufreq *priv = &mt7621_priv;
+
+	if (!of_machine_is_compatible("mediatek,mt7621-soc"))
+		return -ENODEV;
+
+	priv->sysc = syscon_regmap_lookup_by_compatible("mediatek,mt7621-sysc");
+	if (IS_ERR(priv->sysc))
+		return PTR_ERR(priv->sysc);
+
+	priv->memc = syscon_regmap_lookup_by_compatible("mediatek,mt7621-memc");
+	if (IS_ERR(priv->memc))
+		return PTR_ERR(priv->memc);
+
+	return cpufreq_register_driver(&mt7621_cpufreq_driver);
+}
+module_init(mt7621_cpufreq_driver_init);
+
+static void __exit mt7621_cpufreq_driver_exit(void)
+{
+	cpufreq_unregister_driver(&mt7621_cpufreq_driver);
+}
+module_exit(mt7621_cpufreq_driver_exit);
+
+MODULE_AUTHOR("OpenWrt Contributors");
+MODULE_DESCRIPTION("CPUfreq driver for MediaTek MT7621 SoCs");
+MODULE_LICENSE("GPL");
